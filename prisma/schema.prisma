generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  INVESTOR
  ADMIN
}
enum TokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}
model User {
  id           String   @id @default(cuid())
  email        String   @unique @db.VarChar(254)
  name         String   @db.VarChar(120)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(INVESTOR)
  isActive     Boolean  @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  sessionVersion Int @default(0) @map("session_version")
  portfolio InvestorPortfolio?
  depositWallet InvestorDepositWallet?
  withdrawals InvestorWithdrawal[]
  tokens       ActionToken[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  @@map("users")
}
model ActionToken {
  id String @id @default(cuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose TokenPurpose
  hash String @unique @db.Char(64)
  expiresAt DateTime @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("action_tokens")
}

enum BotRunState {
  OFFLINE
  IDLE
  MONITORING
  TRADING
  PAUSED
  ERROR
}

model BotStatus {
  botId                     String @id @map("bot_id") @db.VarChar(64)
  state                     BotRunState @default(OFFLINE)
  currentEventTicker        String? @map("current_event_ticker") @db.VarChar(200)
  currentEventClosesAt      DateTime? @map("current_event_closes_at")
  inventoryYesContracts     Int @default(0) @map("inventory_yes_contracts")
  inventoryNoContracts      Int @default(0) @map("inventory_no_contracts")
  availableFundsUsdcMicros  BigInt @default(0) @map("available_funds_usdc_micros")
  releasableFundsUsdcMicros BigInt @default(0) @map("releasable_funds_usdc_micros")
  realizedPnlUsdcMicros     BigInt @default(0) @map("realized_pnl_usdc_micros")
  unrealizedPnlUsdcMicros   BigInt @default(0) @map("unrealized_pnl_usdc_micros")
  asOf                      DateTime @map("as_of")
  updatedAt                 DateTime @updatedAt @map("updated_at")
  trades                    BotTrade[]
  @@map("bot_status")
}

/** Registered trading bots; each bot has at most one active market snapshot. */
model Bot {
  id String @id @db.VarChar(64)
  name String @db.VarChar(120)
  description String @db.VarChar(500)
  activeTrade ActiveBotTrade?
  @@map("bots")
}

/** Latest active 15-minute market snapshot: Python bot upserts by bot_id. */
model ActiveBotTrade {
  botId String @id @map("bot_id") @db.VarChar(64)
  bot Bot @relation(fields:[botId],references:[id],onDelete:Restrict)
  status BotRunState @default(OFFLINE)
  eventTicker String? @map("event_ticker") @db.VarChar(200)
  yesContracts Int @default(0) @map("yes_contracts")
  noContracts Int @default(0) @map("no_contracts")
  yesCostUsdcMicros BigInt @default(0) @map("yes_cost_usdc_micros")
  noCostUsdcMicros BigInt @default(0) @map("no_cost_usdc_micros")
  asOf DateTime @map("as_of")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("active_bot_trade")
}

model BotTrade {
  id                      String @id @default(cuid())
  botId                   String @map("bot_id") @db.VarChar(64)
  bot                     BotStatus @relation(fields: [botId], references: [botId])
  externalTradeId         String @unique @map("external_trade_id") @db.VarChar(180)
  eventTicker             String @map("event_ticker") @db.VarChar(200)
  side                    String @db.VarChar(12)
  outcome                 String? @db.VarChar(12)
  contracts               Int
  entryCostUsdcMicros     BigInt @map("entry_cost_usdc_micros")
  payoutUsdcMicros        BigInt? @map("payout_usdc_micros")
  feesUsdcMicros          BigInt @default(0) @map("fees_usdc_micros")
  realizedPnlUsdcMicros   BigInt? @map("realized_pnl_usdc_micros")
  openedAt                DateTime @map("opened_at")
  settledAt               DateTime? @map("settled_at")
  @@index([botId, openedAt])
  @@map("bot_trades")
}

model InvestorPortfolio {
  id String @id @default(cuid())
  userId String @unique @map("user_id")
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  mode String @default("SANDBOX") @db.VarChar(16)
  depositedKobo BigInt @default(0) @map("deposited_kobo")
  depositedUsdcMicros BigInt @default(0) @map("deposited_usdc_micros")
  allocatedKobo BigInt @default(0) @map("allocated_kobo")
  allocatedUsdcMicros BigInt @default(0) @map("allocated_usdc_micros")
  unallocatedKobo BigInt @default(0) @map("unallocated_kobo")
  unallocatedUsdcMicros BigInt @default(0) @map("unallocated_usdc_micros")
  realizedPnlKobo BigInt @default(0) @map("realized_pnl_kobo")
  realizedPnlUsdcMicros BigInt @default(0) @map("realized_pnl_usdc_micros")
  pendingDepositsKobo BigInt @default(0) @map("pending_deposits_kobo")
  pendingDepositsUsdcMicros BigInt @default(0) @map("pending_deposits_usdc_micros")
  pendingWithdrawalsKobo BigInt @default(0) @map("pending_withdrawals_kobo")
  pendingWithdrawalsUsdcMicros BigInt @default(0) @map("pending_withdrawals_usdc_micros")
  updatedAt DateTime @updatedAt @map("updated_at")
  activity InvestorActivity[]
  withdrawals InvestorWithdrawal[]
  @@map("investor_portfolios")
}

enum InvestorActivityType {
  DEPOSIT_REQUESTED
  DEPOSIT_CONFIRMED
  ALLOCATION
  DEALLOCATION
  TRADE_SETTLEMENT
  WITHDRAWAL_REQUESTED
  WITHDRAWAL_COMPLETED
  ADJUSTMENT
}

model InvestorActivity {
  id String @id @default(cuid())
  portfolioId String @map("portfolio_id")
  portfolio InvestorPortfolio @relation(fields:[portfolioId],references:[id],onDelete:Restrict)
  type InvestorActivityType
  amountKobo BigInt @map("amount_kobo")
  amountUsdcMicros BigInt @default(0) @map("amount_usdc_micros")
  reference String? @unique @db.VarChar(180)
  description String @db.VarChar(320)
  occurredAt DateTime @default(now()) @map("occurred_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([portfolioId,occurredAt])
  @@map("investor_activity")
}

enum DepositWalletStatus {
  CREATING
  ACTIVE
  ERROR
}

model InvestorDepositWallet {
  id String @id @default(cuid())
  userId String @unique @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  provider String @default("BLOCKRADAR")
  network String @default("solana")
  masterWalletId String @map("master_wallet_id")
  addressId String? @unique @map("address_id")
  address String? @unique @map("address") @db.VarChar(128)
  status DepositWalletStatus @default(CREATING)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deposits BlockchainDeposit[]
  @@map("investor_deposit_wallets")
}

enum BlockchainDepositStatus {
  CONFIRMING
  CONFIRMED
}

model BlockchainDeposit {
  id String @id @default(cuid())
  walletId String @map("wallet_id")
  wallet InvestorDepositWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  providerTransactionId String @unique @map("provider_transaction_id")
  transactionHash String @map("transaction_hash") @db.VarChar(180)
  assetAddress String @map("asset_address") @db.VarChar(128)
  amountUsdcMicros BigInt @map("amount_usdc_micros")
  status BlockchainDepositStatus @default(CONFIRMING)
  sweepHash String? @map("sweep_hash") @db.VarChar(180)
  creditedAt DateTime? @map("credited_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([walletId, createdAt])
  @@map("blockchain_deposits")
}

enum WithdrawalStatus {
  PROCESSING
  SUCCESS
  REQUESTED
  SUBMITTING
  PENDING
  COMPLETED
  FAILED
  REVIEW
}

model InvestorWithdrawal {
  id String @id @default(cuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  portfolioId String @map("portfolio_id")
  portfolio InvestorPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Restrict)
  amountUsdcMicros BigInt @map("amount_usdc_micros")
  grossUsdcMicros BigInt @map("gross_usdc_micros")
  asset String @default("USDC") @db.VarChar(16)
  feeUsdcMicros BigInt @default(2000000) @map("fee_usdc_micros")
  destinationAddress String @map("destination_address") @db.VarChar(128)
  status WithdrawalStatus @default(REQUESTED)
  providerTransactionId String? @unique @map("provider_transaction_id") @db.VarChar(180)
  transactionHash String? @map("transaction_hash") @db.VarChar(180)
  failureCode String? @map("failure_code") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("investor_withdrawals")
}

model MasterWalletBalance {
  walletId String @id @map("wallet_id")
  confirmedUsdcMicros BigInt @default(0) @map("confirmed_usdc_micros")
  reservedUsdcMicros BigInt @default(0) @map("reserved_usdc_micros")
  feeReserveUsdcMicros BigInt @default(0) @map("fee_reserve_usdc_micros")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("master_wallet_balances")
}
