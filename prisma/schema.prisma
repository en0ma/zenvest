generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  USER
  ADMIN
}
enum TokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}
model User {
  id           String   @id @default(cuid())
  email        String   @unique @db.VarChar(254)
  name         String   @db.VarChar(120)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(USER)
  isActive     Boolean  @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  sessionVersion Int @default(0) @map("session_version")
  unallocated BigInt @default(0)
  depositWallet InvestorDepositWallet?
  withdrawals InvestorWithdrawal[]
  webhookDeadLater WebhookDeadLater[]
  positions InvestorPosition[]
  positionAllocations PositionAllocation[]
  activity InvestorActivity[]
  tokens       ActionToken[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  @@map("users")
}
model ActionToken {
  id String @id @default(cuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose TokenPurpose
  hash String @unique @db.Char(64)
  expiresAt DateTime @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("action_tokens")
}

enum StrategyStatus {
  OFFLINE
  IDLE
  MONITORING
  TRADING
  PAUSED
  ERROR
}
enum MarketType {
  PREDICTION
  PERP
  SPOT
}
model Strategy {
  id String @id @db.VarChar(64)
  name String @unique @db.VarChar(120)
  description String @db.VarChar(500)
  note String? @db.VarChar(1000)
  minCapacityUsdcMicros BigInt @default(0) @map("min_capacity_usdc_micros")
  maxCapacityUsdcMicros BigInt @default(0) @map("max_capacity_usdc_micros")
  availableCapacityUsdcMicros BigInt @default(0) @map("available_capacity_usdc_micros")
  minAllocationUsdcMicros BigInt @default(0) @map("min_allocation_usdc_micros")
  maxAllocationUsdcMicros BigInt @default(0) @map("max_allocation_usdc_micros")
  platformProfitPercentage Decimal @default(0) @map("platform_profit_percentage") @db.Decimal(7,4)
  isActive Boolean @default(false) @map("is_active")
  isPublic Boolean @default(false) @map("is_public")
  status StrategyStatus @default(OFFLINE)
  marketType MarketType @default(PREDICTION) @map("market_type")
  marketId String? @map("market_id") @db.VarChar(200)
  marketName String? @map("market_name") @db.VarChar(200)
  kalshiWalletAddress String? @map("kalshi_wallet_address") @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  positions InvestorPosition[]
  strategyEvents StrategyEvent[]
  positionEvents PositionAllocation[]
  trades StrategyTrade[]
  @@index([isActive,isPublic])
  @@map("strategies")
}
/** A strategy's event trade record, keyed by Kalshi event ID and strategy. */
enum StrategyTradeStatus {
  TRADING
  ENDED
  ERROR
}
model StrategyTrade {
  id String @id @default(cuid()) @db.VarChar(64)
  strategyId String @map("strategy_id") @db.VarChar(64)
  strategy Strategy @relation(fields:[strategyId],references:[id],onDelete:Restrict)
  marketTradeId String? @map("market_trade_id") @db.VarChar(180)
  marketTradeName String @map("market_trade_name") @db.VarChar(200)
  status StrategyTradeStatus @default(TRADING)
  yesContracts Int @default(0) @map("yes_contracts")
  noContracts Int @default(0) @map("no_contracts")
  yesCostUsdcMicros BigInt @default(0) @map("yes_cost_usdc_micros")
  noCostUsdcMicros BigInt @default(0) @map("no_cost_usdc_micros")
  realizedPnlUsdcMicros BigInt? @map("realized_pnl_usdc_micros")
  profit Decimal? @map("profit") @db.Decimal(20,8)
  platformProfitShare Decimal? @map("platform_profit_share") @db.Decimal(20,8)
  marketStart DateTime? @map("market_start")
  marketEnd DateTime? @map("market_end")
  openPrice Decimal? @map("open_price") @db.Decimal(20,8)
  closePrice Decimal? @map("close_price") @db.Decimal(20,8)
  currentPrice Decimal? @map("current_price") @db.Decimal(20,8)
  createdAt DateTime @default(now()) @map("created_at")
  settledAt DateTime? @map("settled_at")
  @@unique([strategyId,marketTradeId])
  @@index([strategyId,createdAt])
  @@map("strategy_trades")
}

enum InvestorActivityType {
  DEPOSIT_REQUESTED
  DEPOSIT_CONFIRMED
  ALLOCATION
  DEALLOCATION
  TRADE_SETTLEMENT
  WITHDRAWAL_REQUESTED
  WITHDRAWAL_COMPLETED
  ADJUSTMENT
}

model InvestorActivity {
  id String @id @default(cuid())
  userId String @map("user_id")
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  type InvestorActivityType
  amountKobo BigInt @map("amount_kobo")
  amountUsdcMicros BigInt @default(0) @map("amount_usdc_micros")
  reference String? @unique @db.VarChar(180)
  description String @db.VarChar(320)
  occurredAt DateTime @default(now()) @map("occurred_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([userId,occurredAt])
  @@map("investor_activity")
}

enum DepositWalletStatus {
  CREATING
  ACTIVE
  ERROR
}

model InvestorDepositWallet {
  id String @id @default(cuid())
  userId String @unique @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  provider String @default("BLOCKRADAR")
  network String @default("solana")
  masterWalletId String @map("master_wallet_id")
  addressId String? @unique @map("address_id")
  address String? @unique @map("address") @db.VarChar(128)
  status DepositWalletStatus @default(CREATING)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deposits BlockchainDeposit[]
  @@map("user_wallets")
}

enum BlockchainDepositStatus {
  CONFIRMING
  CONFIRMED
}

model BlockchainDeposit {
  id String @id @default(cuid())
  walletId String @map("wallet_id")
  wallet InvestorDepositWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  providerTransactionId String @unique @map("provider_transaction_id")
  transactionHash String @map("transaction_hash") @db.VarChar(180)
  assetAddress String @map("asset_address") @db.VarChar(128)
  amountUsdcMicros BigInt @map("amount_usdc_micros")
  feeUsdcMicros BigInt @default(0) @map("fee_usdc_micros")
  status BlockchainDepositStatus @default(CONFIRMING)
  sweepHash String? @map("sweep_hash") @db.VarChar(180)
  creditedAt DateTime? @map("credited_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([walletId, createdAt])
  @@map("deposits")
}

enum WithdrawalStatus {
  PENDING
  SUBMITTING
  PROCESSING
  REVIEW
  COMPLETED
  FAILED
  CANCELLED
}

model InvestorWithdrawal {
  id String @id @default(cuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  amountUsdcMicros BigInt @map("amount_usdc_micros")
  grossUsdcMicros BigInt @map("gross_usdc_micros")
  asset String @default("USDC") @db.VarChar(16)
  feeUsdcMicros BigInt @default(2000000) @map("fee_usdc_micros")
  destinationAddress String @map("destination_address") @db.VarChar(128)
  idempotencyKey String @map("idempotency_key") @db.VarChar(64)
  status WithdrawalStatus @default(PENDING)
  providerTransactionId String? @unique @map("provider_transaction_id") @db.VarChar(180)
  transactionHash String? @map("transaction_hash") @db.VarChar(180)
  failureCode String? @map("failure_code") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")
  treasuryId String? @map("treasury_id")
  treasury TreasuryTransfer? @relation(fields:[treasuryId],references:[id],onDelete:Restrict)
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([treasuryId])
  @@map("withdrawals")
}

enum TreasurySource {
  KALSHI
  MASTER_WALLET
}
enum TreasuryKind {
  WITHDRAWAL_FEE
  DEPOSIT_FEE
  DEPOSIT
  DEALLOCATE
  ALLOCATE
  M_BANK
  K_BANK
}
/** Treasury accounting entries; not a substitute for custody reconciliation. */
model Treasury {
  id String @id @default(cuid())
  walletAddress String @map("wallet_address") @db.VarChar(180)
  walletId String @map("wallet_id") @db.VarChar(180)
  asset String @default("USDC") @db.VarChar(16)
  network String @default("solana") @db.VarChar(32)
  source TreasurySource
  kind TreasuryKind @unique
  amount BigInt
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([walletId,asset,network])
  @@index([source,kind])
  @@map("treasuries")
}





/** Investor-controlled position; principal only changes on independently verified funding/return. */
enum PositionStatus {
  PENDING
  ACTIVE
  CLOSED
}

enum PositionTransferStatus {
  PENDING
  SUBMITTING
  PROCESSING
  CONFIRMING
  REVIEW
  COMPLETED
  FAILED
  CANCELLED
}

model InvestorPosition {
  id String @id @default(cuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  strategyId String @map("strategy_id") @db.VarChar(64)
  strategy Strategy @relation(fields:[strategyId], references:[id],onDelete:Restrict)
  principalUsdcMicros BigInt @default(0) @map("principal_usdc_micros")
  realizedPnlUsdcMicros BigInt @default(0) @map("realized_pnl_usdc_micros")
  status PositionStatus @default(PENDING)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  closedAt DateTime? @map("closed_at")
  allocations PositionAllocation[]
  @@index([userId, status, createdAt])
  @@map("positions")
}

// Preserve POST idempotency outside the requested unified event payload.
model PositionEventRequest {
  requestKey String @id @map("request_key") @db.VarChar(180)
  positionEventId String @unique @map("position_event_id")
  positionEvent PositionAllocation @relation(fields:[positionEventId],references:[id],onDelete:Restrict)
  createdAt DateTime @default(now()) @map("created_at")
  @@map("position_event_requests")
}

model PositionAllocation {
  id String @id @default(cuid())
  kind StrategyEventKind @default(ALLOCATE)
  strategyId String @map("strategy_id") @db.VarChar(64)
  strategy Strategy @relation(fields:[strategyId],references:[id],onDelete:Restrict)
  strategyEventId String? @map("strategy_event_id")
  strategyEvent StrategyEvent? @relation(fields:[strategyEventId],references:[id],onDelete:Restrict)
  positionId String @map("position_id")
  position InvestorPosition @relation(fields: [positionId], references: [id], onDelete: Restrict)
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  amountUsdcMicros BigInt @map("amount_usdc_micros")
  status PositionTransferStatus @default(PENDING)
  request PositionEventRequest?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([userId, createdAt])
  @@index([strategyId,kind,strategyEventId,status])
  @@index([status, createdAt])
  @@map("position_events")
}

// One pooled capital movement per strategy, before any treasury settlement.
enum StrategyEventKind {
  ALLOCATE
  DEALLOCATE
}
enum StrategyEventStatus {
  PROCESSING
  CONFIRMING
  COMPLETED
}
model StrategyEvent {
  id String @id @default(cuid())
  kind StrategyEventKind
  amountUsdcMicros BigInt @map("amount_usdc_micros")
  strategyId String @map("strategy_id") @db.VarChar(64)
  strategy Strategy @relation(fields:[strategyId],references:[id],onDelete:Restrict)
  status StrategyEventStatus @default(PROCESSING)
  treasuryTransactionId String? @unique @map("treasury_transaction_id")
  treasuryTransaction TreasuryTransfer? @relation(fields:[treasuryTransactionId],references:[id],onDelete:Restrict)
  positionEvents PositionAllocation[]
  sourceConfirmed Boolean @default(false) @map("source_confirmed")
  destinationConfirmed Boolean @default(false) @map("destination_confirmed")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([strategyId,kind,status,createdAt])
  @@map("strategy_events")
}

enum TreasuryDirection {
  DEPOSIT
  ALLOCATE
  DEALLOCATE
  WITHDRAWAL
  PLATFORM_PULL
  PLATFORM_M_BANK
  PLATFORM_K_BANK
}
enum TreasuryStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
  REVIEW
}
/** One treasury transfer may fund or return capital for multiple investor positions. */
model TreasuryTransfer {
  id String @id @default(cuid())
  direction TreasuryDirection
  status TreasuryStatus @default(PENDING)
  assetId String? @map("asset_id") @db.VarChar(180)
  asset String @default("USDC") @db.VarChar(16)
  amountUsdcMicros BigInt @map("amount_usdc_micros")
  feeUsdcMicros BigInt @default(0) @map("fee_usdc_micros")
  destinationWalletAddress String @map("destination_wallet_address") @db.VarChar(180)
  network String @default("solana") @db.VarChar(32)
  masterWalletAddress String @map("master_wallet_address") @db.VarChar(180)
  masterWalletId String @map("master_wallet_id") @db.VarChar(180)
  originExternalId String? @map("origin_external_id") @db.VarChar(180)
  destinationExternalId String? @map("destination_external_id") @db.VarChar(180)
  reference String @unique @db.VarChar(180)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")
  strategyEvent StrategyEvent?
  withdrawals InvestorWithdrawal[]
  @@index([direction,status,createdAt])
  @@index([originExternalId])
  @@index([destinationExternalId])
  @@map("treasury_transactions")
}

/** Signed, late success webhooks for withdrawals already marked FAILED. */
model WebhookDeadLater {
  id String @id @default(cuid())
  kind String @db.VarChar(32)
  userId String @map("user_id")
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  reference String @db.VarChar(180)
  providerTransactionId String @map("provider_transaction_id") @db.VarChar(180)
  payload Json
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([kind,reference,providerTransactionId])
  @@index([userId,createdAt])
  @@map("webhook_dead_later")
}

enum WebhookSource {
  BLOCKRADAR
  KALSHI
}
enum WebhookQueueStatus {
  PENDING
  PROCESSED
}
model WebhookQueue {
  id String @id @default(cuid())
  source WebhookSource
  eventType String @map("event_type") @db.VarChar(120)
  idempotencyKey String @map("idempotency_key") @db.VarChar(200)
  payload Json
  status WebhookQueueStatus @default(PENDING)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  processedAt DateTime? @map("processed_at")
  leaseUntil DateTime? @map("lease_until")
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
  attempts Int @default(0)
  lastError String? @map("last_error") @db.VarChar(200)
  @@unique([source,idempotencyKey])
  @@index([status,createdAt])
  @@map("webhook_queue")
}
