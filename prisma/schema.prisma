generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum TokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}
model User {
  id           String   @id @default(cuid())
  email        String   @unique @db.VarChar(254)
  name         String   @db.VarChar(120) // Legacy account label while existing consumers migrate to handle.
  handle       String   @unique @default(dbgenerated("substr(md5(random()::text || clock_timestamp()::text), 1, 8)")) @db.VarChar(8)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  isActive     Boolean  @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  sessionVersion Int @default(0) @map("session_version")
  twoFactor TwoFactor?
  securitySessions SecuritySession[]
  recoveryCodes TwoFactorRecoveryCode[]
  unallocated BigInt @default(0)
  depositWallet InvestorDepositWallet?
  sentTransfers Send[] @relation("SentTransfer")
  receivedTransfers Send[] @relation("ReceivedTransfer")
  recipients UserRecipient[]
  withdrawals Withdrawal[]
  webhookDeadLater WebhookDeadLater[]
  positions InvestorPosition[]
  positionAllocations PositionAllocation[]
  tradePnls PositionTradePnl[]
  activity InvestorActivity[]
  roles UserRole[]
  bots Bot[]
  botApiKeys BotApiKey[]
  botManagerNotices BotManagerNotice[]
  tokens       ActionToken[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  @@map("users")
}
model ActionToken {
  id String @id @default(cuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose TokenPurpose
  hash String @unique @db.Char(64)
  expiresAt DateTime @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("action_tokens")
}

enum StrategyStatus {
  OFFLINE
  IDLE
  MONITORING
  TRADING
  PAUSED
  ERROR
  ONBOARDING
  SHUTTING_DOWN
  SHUTDOWN
}
enum MarketType {
  PREDICTION
  PERP
  SPOT
}
model Strategy {
  id String @id @db.VarChar(64)
  name String @unique @db.VarChar(120)
  symbol String? @unique @db.VarChar(8)
  logo String? @db.VarChar(500)
  description String @db.VarChar(500)
  note String? @db.VarChar(1000)
  minCapacityUsdcMicros BigInt @default(0) @map("min_capacity_usdc_micros")
  maxCapacityUsdcMicros BigInt @default(0) @map("max_capacity_usdc_micros")
  availableCapacityUsdcMicros BigInt @default(0) @map("available_capacity_usdc_micros")
  minAllocationUsdcMicros BigInt @default(0) @map("min_allocation_usdc_micros")
  maxAllocationUsdcMicros BigInt @default(0) @map("max_allocation_usdc_micros")
  platformProfitPercentage Decimal @default(0) @map("platform_profit_percentage") @db.Decimal(7,4)
  isActive Boolean @default(false) @map("is_active")
  isPublic Boolean @default(false) @map("is_public")
  status StrategyStatus @default(OFFLINE)
  publicKey String? @unique @map("public_key") @db.VarChar(64)
  managerProfitPercentage Decimal @default(0) @map("manager_profit_percentage") @db.Decimal(7,4)
  platformStrategyPercentage Decimal @default(0) @map("platform_strategy_percentage") @db.Decimal(7,4)
  sandboxFeeBps Int? @map("sandbox_fee_bps")
  admissionMinDays Int? @map("admission_min_days")
  admissionMinFills Int? @map("admission_min_fills")
  admissionMaxDrawdownPct Decimal? @map("admission_max_drawdown_pct") @db.Decimal(7,4)
  marketType MarketType @default(PREDICTION) @map("market_type")
  venue String? @db.VarChar(32)
  eventTag String? @map("event_tag") @db.VarChar(120)
  marketId String? @map("market_id") @db.VarChar(200)
  marketName String? @map("market_name") @db.VarChar(200)
  kalshiWalletAddress String? @map("kalshi_wallet_address") @db.VarChar(128)
  blockRadarAddress String? @unique @map("block_radar_address") @db.VarChar(128)
  blockRadarAddressId String? @unique @map("block_radar_address_id") @db.VarChar(160)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  positions InvestorPosition[]
  strategyEvents StrategyEvent[]
  positionEvents PositionAllocation[]
  trades StrategyTrade[]
  bot Bot?
  sandboxAccount SandboxAccount?
  sandboxFills SandboxFill[]
  sandboxSettlements SandboxSettlement[]
  revenueRateVersions StrategyRevenueRateVersion[]
  shutdownEventId String? @unique @map("shutdown_event_id") @db.VarChar(64)
  @@index([isActive,isPublic])
  @@map("strategies")
}
/** A strategy's event trade record, keyed by Kalshi event ID and strategy. */
enum StrategyTradeStatus {
  AWAITING_ALLOCATION
  TRADING
  SETTLED
  ENDED
  ERROR
}
model StrategyTrade {
  id String @id @default(cuid()) @db.VarChar(64)
  strategyId String @map("strategy_id") @db.VarChar(64)
  strategy Strategy @relation(fields:[strategyId],references:[id],onDelete:Restrict)
  marketTradeId String? @map("market_trade_id") @db.VarChar(180)
  marketTradeName String @map("market_trade_name") @db.VarChar(200)
  status StrategyTradeStatus @default(AWAITING_ALLOCATION)
  isPnlCalculated Boolean @default(false) @map("is_pnl_calculated")
  eligibleCapitalUsdcMicros BigInt @default(0) @map("eligible_capital_usdc_micros")
  appliedPlatformProfitPercentage Decimal? @map("applied_platform_profit_percentage") @db.Decimal(7,4)
  yesContracts Int @default(0) @map("yes_contracts")
  noContracts Int @default(0) @map("no_contracts")
  yesCostUsdcMicros BigInt @default(0) @map("yes_cost_usdc_micros")
  noCostUsdcMicros BigInt @default(0) @map("no_cost_usdc_micros")
  realizedPnlUsdcMicros BigInt? @map("realized_pnl_usdc_micros")
  profit Decimal? @map("profit") @db.Decimal(20,8)
  platformProfitShare Decimal? @map("platform_profit_share") @db.Decimal(20,8)
  marketStart DateTime? @map("market_start")
  marketEnd DateTime? @map("market_end")
  openPrice Decimal? @map("open_price") @db.Decimal(20,8)
  closePrice Decimal? @map("close_price") @db.Decimal(20,8)
  currentPrice Decimal? @map("current_price") @db.Decimal(20,8)
  createdAt DateTime @default(now()) @map("created_at")
  settledAt DateTime? @map("settled_at")
  positionTradePnls PositionTradePnl[]
  @@unique([strategyId,marketTradeId])
  @@index([strategyId,createdAt])
  @@map("strategy_trades")
}

enum InvestorActivityType {
  DEPOSIT_REQUESTED
  DEPOSIT_CONFIRMED
  ALLOCATION
  DEALLOCATION
  TRADE_SETTLEMENT
  WITHDRAWAL_REQUESTED
  WITHDRAWAL_COMPLETED
  ADJUSTMENT
}

model InvestorActivity {
  id String @id @default(cuid())
  userId String @map("user_id")
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  type InvestorActivityType
  amountKobo BigInt @map("amount_kobo")
  amountUsdcMicros BigInt @default(0) @map("amount_usdc_micros")
  reference String? @unique @db.VarChar(180)
  description String @db.VarChar(320)
  occurredAt DateTime @default(now()) @map("occurred_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([userId,occurredAt])
  @@map("investor_activity")
}

enum DepositWalletStatus {
  CREATING
  ACTIVE
  ERROR
}

model InvestorDepositWallet {
  id String @id @default(cuid())
  userId String @unique @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  provider String @default("BLOCKRADAR")
  network String @default("solana")
  masterWalletId String @map("master_wallet_id")
  addressId String? @unique @map("address_id")
  address String? @unique @map("address") @db.VarChar(128)
  status DepositWalletStatus @default(CREATING)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deposits BlockchainDeposit[]
  @@map("user_wallets")
}

enum BlockchainDepositStatus {
  CONFIRMING
  CONFIRMED
}

model BlockchainDeposit {
  id String @id @default(cuid())
  walletId String @map("wallet_id")
  wallet InvestorDepositWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  providerTransactionId String @unique @map("provider_transaction_id")
  transactionHash String @map("transaction_hash") @db.VarChar(180)
  senderAddress String? @map("sender_address") @db.VarChar(128)
  assetAddress String @map("asset_address") @db.VarChar(128)
  amountUsdcMicros BigInt @map("amount_usdc_micros")
  feeUsdcMicros BigInt @default(0) @map("fee_usdc_micros")
  status BlockchainDepositStatus @default(CONFIRMING)
  sweepHash String? @map("sweep_hash") @db.VarChar(180)
  creditedAt DateTime? @map("credited_at")
  treasuryTransactionId String? @unique @map("treasury_transaction_id")
  treasuryTransaction TreasuryTransfer? @relation("DepositTreasuryTransaction",fields:[treasuryTransactionId],references:[id],onDelete:Restrict)
  createdAt DateTime @default(now()) @map("created_at")
  @@index([walletId, createdAt])
  @@map("deposits")
}

enum WithdrawalStatus {
  PENDING
  SUBMITTING
  PROCESSING
  REVIEW
  COMPLETED
  FAILED
  CANCELLED
}

model Withdrawal {
  id String @id @default(cuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  amountUsdcMicros BigInt @map("amount_usdc_micros")
  grossUsdcMicros BigInt @map("gross_usdc_micros")
  asset String @default("USDC") @db.VarChar(16)
  feeUsdcMicros BigInt @default(2000000) @map("fee_usdc_micros")
  destinationAddress String @map("destination_address") @db.VarChar(128)
  status WithdrawalStatus @default(PENDING)
  providerTransactionId String? @unique @map("provider_transaction_id") @db.VarChar(180)
  transactionHash String? @map("transaction_hash") @db.VarChar(180)
  failureCode String? @map("failure_code") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")
  treasuryTransactionId String? @map("treasury_transaction_id")
  treasuryTransaction TreasuryTransfer? @relation(fields:[treasuryTransactionId],references:[id],onDelete:Restrict)
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([treasuryTransactionId])
  @@map("withdrawals")
}

enum TreasurySource {
  KALSHI
  MASTER_WALLET
}
enum TreasuryKind {
  WITHDRAWAL_FEE
  DEPOSIT_FEE
  DEPOSIT
  DEALLOCATE
  ALLOCATE
  M_BANK
  K_BANK
}
/** Treasury accounting entries; not a substitute for custody reconciliation. */
model Treasury {
  id String @id @default(cuid())
  walletAddress String @map("wallet_address") @db.VarChar(180)
  walletId String @map("wallet_id") @db.VarChar(180)
  asset String @default("USDC") @db.VarChar(16)
  network String @default("solana") @db.VarChar(32)
  source TreasurySource
  kind TreasuryKind @unique
  amount BigInt
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([walletId,asset,network])
  @@index([source,kind])
  @@map("treasuries")
}





/** Investor-controlled position; principal only changes on independently verified funding/return. */
enum PositionStatus {
  OPEN
  CLOSING
  CLOSED
}

enum PositionTransferStatus {
  PENDING
  SUBMITTING
  DEALLOCATING
  PROCESSING
  CONFIRMING
  AWAITING_ALLOCATION
  AWAITING_DEALLOCATION
  AWAITING_WITHDRAWAL
  REVIEW
  COMPLETED
  FAILED
  CANCELLED
}

model InvestorPosition {
  id String @id @default(cuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  strategyId String @map("strategy_id") @db.VarChar(64)
  strategy Strategy @relation(fields:[strategyId], references:[id],onDelete:Restrict)
  allocatedUsdcMicros BigInt @default(0) @map("allocated_usdc_micros")
  lastPnlUpdated Boolean @default(false) @map("last_pnl_updated")
  status PositionStatus @default(OPEN)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  closedAt DateTime? @map("closed_at")
  allocations PositionAllocation[]
  tradePnls PositionTradePnl[]
  @@index([userId, status, createdAt])
  @@map("positions")
}

model PositionAllocation {
  id String @id @default(cuid())
  kind StrategyEventKind @default(ALLOCATE)
  strategyId String @map("strategy_id") @db.VarChar(64)
  strategy Strategy @relation(fields:[strategyId],references:[id],onDelete:Restrict)
  strategyEventId String? @map("strategy_event_id")
  strategyEvent StrategyEvent? @relation(fields:[strategyEventId],references:[id],onDelete:Restrict)
  positionId String @map("position_id")
  position InvestorPosition @relation(fields: [positionId], references: [id], onDelete: Restrict)
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  amountUsdcMicros BigInt @map("amount_usdc_micros")
  status PositionTransferStatus @default(PENDING)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([userId, createdAt])
  @@index([strategyId,kind,strategyEventId,status])
  @@index([status, createdAt])
  @@map("position_events")
}

// One pooled capital movement per strategy, before any treasury settlement.
enum StrategyEventKind {
  ALLOCATE
  DEALLOCATE
}
enum StrategyEventStatus {
  PROCESSING
  CONFIRMING
  COMPLETED
}
model StrategyEvent {
  id String @id @default(cuid())
  kind StrategyEventKind
  amountUsdcMicros BigInt @map("amount_usdc_micros")
  strategyId String @map("strategy_id") @db.VarChar(64)
  strategy Strategy @relation(fields:[strategyId],references:[id],onDelete:Restrict)
  status StrategyEventStatus @default(PROCESSING)
  treasuryTransactionId String? @unique @map("treasury_transaction_id")
  treasuryTransaction TreasuryTransfer? @relation(fields:[treasuryTransactionId],references:[id],onDelete:Restrict)
  positionEvents PositionAllocation[]
  kalshiWithdrawalId String? @unique @map("kalshi_withdrawal_id") @db.VarChar(200)
  sourceConfirmed Boolean @default(false) @map("source_confirmed")
  destinationConfirmed Boolean @default(false) @map("destination_confirmed")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([strategyId,kind,status,createdAt])
  @@map("strategy_events")
}

enum TreasuryDirection {
  DEPOSIT
  ALLOCATE
  DEALLOCATE
  WITHDRAWAL
  // Active staff ledger directions, named for the custody bucket.
  K_BANK_DEPOSIT
  K_BANK_WITHDRAWAL
  M_BANK_DEPOSIT
  M_BANK_WITHDRAWAL
}
enum TreasuryStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
  REVIEW
}
/** One treasury transfer may fund or return capital for multiple investor positions. */
model TreasuryTransfer {
  id String @id @default(cuid())
  direction TreasuryDirection
  status TreasuryStatus @default(PENDING)
  assetId String? @map("asset_id") @db.VarChar(180)
  asset String @default("USDC") @db.VarChar(16)
  amountUsdcMicros BigInt @map("amount_usdc_micros")
  feeUsdcMicros BigInt @default(0) @map("fee_usdc_micros")
  destinationWalletAddress String @map("destination_wallet_address") @db.VarChar(180)
  network String @default("solana") @db.VarChar(32)
  masterWalletAddress String @map("master_wallet_address") @db.VarChar(180)
  masterWalletId String @map("master_wallet_id") @db.VarChar(180)
  originExternalId String? @map("origin_external_id") @db.VarChar(180)
  destinationExternalId String? @map("destination_external_id") @db.VarChar(180)
  reference String @unique @db.VarChar(180)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")
  strategyEvent StrategyEvent?
  withdrawals Withdrawal[]
  deposit BlockchainDeposit? @relation("DepositTreasuryTransaction")
  @@index([direction,status,createdAt])
  @@index([originExternalId])
  @@index([destinationExternalId])
  @@map("treasury_transactions")
}

/** Signed, late success webhooks for withdrawals already marked FAILED. */
model WebhookDeadLater {
  id String @id @default(cuid())
  kind String @db.VarChar(32)
  userId String @map("user_id")
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  reference String @db.VarChar(180)
  providerTransactionId String @map("provider_transaction_id") @db.VarChar(180)
  payload Json
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([kind,reference,providerTransactionId])
  @@index([userId,createdAt])
  @@map("webhook_dead_later")
}

enum WebhookSource {
  BLOCKRADAR
  KALSHI
}
enum WebhookQueueStatus {
  PENDING
  PROCESSED
}
model WebhookQueue {
  id String @id @default(cuid())
  source WebhookSource
  eventType String @map("event_type") @db.VarChar(120)
  idempotencyKey String @map("idempotency_key") @db.VarChar(200)
  payload Json
  status WebhookQueueStatus @default(PENDING)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  processedAt DateTime? @map("processed_at")
  leaseUntil DateTime? @map("lease_until")
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
  attempts Int @default(0)
  lastError String? @map("last_error") @db.VarChar(200)
  @@unique([source,idempotencyKey])
  @@index([status,createdAt])
  @@map("webhook_queue")
}

// Immutable trade exposure basis; settlement columns are filled once by the P&L worker.
enum PositionTradePnlStatus {
  SNAPSHOTTED
  SETTLED
}
model PositionTradePnl {
  id String @id @default(cuid())
  strategyTradeId String @map("strategy_trade_id") @db.VarChar(64)
  strategyTrade StrategyTrade @relation(fields:[strategyTradeId],references:[id],onDelete:Restrict)
  positionId String @map("position_id")
  position InvestorPosition @relation(fields:[positionId],references:[id],onDelete:Restrict)
  userId String @map("user_id")
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  eligibleCapitalUsdcMicros BigInt @map("eligible_capital_usdc_micros")
  grossPnlUsdcMicros BigInt? @map("gross_pnl_usdc_micros")
  platformFeeUsdcMicros BigInt? @map("platform_fee_usdc_micros")
  netPnlUsdcMicros BigInt? @map("net_pnl_usdc_micros")
  status PositionTradePnlStatus @default(SNAPSHOTTED)
  createdAt DateTime @default(now()) @map("created_at")
  settledAt DateTime? @map("settled_at")
  @@unique([strategyTradeId,positionId])
  @@index([userId,status,settledAt])
  @@index([positionId,status,settledAt])
  @@map("position_trade_pnl")
}



enum RecipientKind {
  WITHDRAW
  SEND
}
enum RecipientStatus {
  PENDING
  COMPLETED
}
enum SendStatus {
  PENDING
  COMPLETED
}
model UserRecipient {
  id String @id @default(cuid())
  userId String @map("user_id")
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  kind RecipientKind
  name String @db.VarChar(120)
  handle String? @db.VarChar(8)
  walletAddress String? @map("wallet_address") @db.VarChar(128)
  network String? @db.VarChar(32)
  status RecipientStatus @default(COMPLETED)
  createdAt DateTime @default(now()) @map("created_at")
  @@index([userId,kind,createdAt])
  @@map("user_recipients")
}
model Send {
  id String @id @default(cuid())
  status SendStatus @default(PENDING)
  createdAt DateTime @default(now()) @map("created_at")
  senderUserId String @map("sender_user_id")
  recipientUserId String @map("recipient_user_id")
  sender User @relation("SentTransfer",fields:[senderUserId],references:[id],onDelete:Restrict)
  recipient User @relation("ReceivedTransfer",fields:[recipientUserId],references:[id],onDelete:Restrict)
  amount BigInt @map("amount")
  note String? @db.VarChar(250)
  senderHandle String @map("sender_handle") @db.VarChar(8)
  recipientHandle String @map("recipient_handle") @db.VarChar(8)
  idempotencyKey String @unique @map("request_key") @db.VarChar(100)
  @@index([senderUserId,createdAt])
  @@index([recipientUserId,createdAt])
  @@map("sends")
}

model TwoFactor {
  userId String @id @map("user_id")
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  method String @db.VarChar(16)
  emailEnabled Boolean @default(false) @map("email_enabled")
  secretEncrypted String? @map("secret_encrypted") @db.Text
  lastTotpStep BigInt @default(-1) @map("last_totp_step")
  verifiedAt DateTime @default(now()) @map("verified_at")
}

model TwoFactorChallenge {
  id String @id @default(cuid())
  userId String @map("user_id")
  purpose String @db.VarChar(16)
  method String @db.VarChar(16)
  codeHash String? @map("code_hash") @db.Text
  attempts Int @default(0)
  expiresAt DateTime @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([userId,purpose,createdAt])
  @@index([expiresAt])
}

model SecuritySession {
 id String @id @db.VarChar(64)
 userId String @map("user_id")
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 lastActivityAt DateTime @default(now()) @map("last_activity_at")
 createdAt DateTime @default(now()) @map("created_at")
 @@index([userId])
 @@index([lastActivityAt])
}

model TwoFactorRecoveryCode {
 id String @id @default(cuid())
 userId String @map("user_id")
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 hash String @unique @db.Char(64)
 usedAt DateTime? @map("used_at")
 createdAt DateTime @default(now()) @map("created_at")
 @@index([userId,usedAt])
}

model Role {
  id String @id @default(cuid())
  key String @unique
  grants RolePermission[]
  members UserRole[]

}
model Permission {
  id String @id @default(cuid())
  key String @unique
  description String @default("") @db.Text
  roles RolePermission[]

}
model RolePermission {
  roleId String
  permissionId String
  role Role @relation(fields:[roleId],references:[id],onDelete:Cascade)
  permission Permission @relation(fields:[permissionId],references:[id],onDelete:Cascade)
  @@id([roleId,permissionId])

}
model UserRole {
  userId String
  roleId String
  assignedBy String
  role Role @relation(fields:[roleId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@id([userId,roleId])

}
enum StaffActionStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
}
model StaffAction {
  id String @id @default(cuid())
  resource String
  operation String
  targetId String
  payload Json
  reason String
  requestedBy String
  decidedBy String?
  status StaffActionStatus @default(PENDING)
  idempotencyKey String @unique
  createdAt DateTime @default(now())
  decidedAt DateTime?
  @@index([status,createdAt])
}
/** Singleton policy for approving sensitive staff actions; Super Admin is always eligible. */
model StaffApprovalPolicy {
  id String @id
  additionalRoleKeys String[] @default([])
  updatedAt DateTime @updatedAt
}

model StaffAudit {
  id String @id @default(cuid())
  actorId String
  action String
  resource String
  targetId String
  createdAt DateTime @default(now())
  @@index([actorId,createdAt])
}

/** Platform-owned master wallet USDC payout. Not an investor Withdrawal. */
enum PlatformWithdrawalStatus {
  PENDING
  SUBMITTING
  PROCESSING
  REVIEW
  COMPLETED
  FAILED
  CANCELLED
}
model PlatformWithdrawal {
  id String @id @default(cuid())
  staffActionId String @unique
  destinationAddress String @db.VarChar(128)
  amountUsdcMicros BigInt
  reservedMBankMicros BigInt @default(0)
  reservedDepositFeeMicros BigInt @default(0)
  reservedWithdrawalFeeMicros BigInt @default(0)
  status PlatformWithdrawalStatus @default(PENDING)
  providerTransactionId String? @unique @db.VarChar(180)
  transactionHash String? @db.VarChar(180)
  failureCode String? @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?
  @@index([status,createdAt])
}

/** Admin Kalshi withdrawal; adapter currently mocked, settlement awaits verified custody. */
model StaffKalshiWithdrawal {
  id String @id @default(cuid())
  staffActionId String @unique
  strategyId String
  amountUsdcMicros BigInt
  masterWalletAddress String @db.VarChar(180)
  providerWithdrawalId String? @unique @map("mockWithdrawalId") @db.VarChar(200)
  status String @default("SUBMITTING") @db.VarChar(32)
  sourceConfirmed Boolean @default(false)
  destinationConfirmed Boolean @default(false)
  masterReceiptId String? @unique @db.VarChar(180)
  treasuryTransactionId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([strategyId,createdAt])
  @@map("StaffKalshiReturnSimulation")
}

model Bot {
 id String @id @default(cuid())
 ownerId String @map("owner_id")
 owner User @relation(fields:[ownerId],references:[id],onDelete:Restrict)
 strategyId String @unique @map("strategy_id") @db.VarChar(64)
 strategy Strategy @relation(fields:[strategyId],references:[id],onDelete:Restrict)
 name String @db.VarChar(120)
 description String @default("") @db.VarChar(500)
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")
 intents BotTradeIntent[]
 @@index([ownerId,createdAt])
 @@map("bots")
}
model BotApiKey {
 id String @id @default(cuid())
 ownerId String @map("owner_id")
 owner User @relation(fields:[ownerId],references:[id],onDelete:Restrict)
 label String @db.VarChar(100)
 keyHash String @unique @map("key_hash") @db.Char(64)
 keyPrefix String @map("key_prefix") @db.VarChar(20)
 createdAt DateTime @default(now()) @map("created_at")
 revokedAt DateTime? @map("revoked_at")
 lastUsedAt DateTime? @map("last_used_at")
 rateLimits BotApiRateLimit[]
 @@index([ownerId,revokedAt])
 @@map("bot_api_keys")
}

/** Atomic persistent per-key fixed-minute limit shared across all app instances. */
model BotApiRateLimit {
 keyId String @map("key_id")
 windowStart DateTime @map("window_start")
 requestCount Int @default(0) @map("request_count")
 key BotApiKey @relation(fields:[keyId],references:[id],onDelete:Cascade)
 @@id([keyId,windowStart])
 @@index([windowStart])
 @@map("bot_api_rate_limits")
}
/** Recorded request, NOT a Kalshi trade, execution or verified settlement. */
model BotTradeIntent {
 id String @id @default(cuid())
 botId String @map("bot_id")
 bot Bot @relation(fields:[botId],references:[id],onDelete:Restrict)
 strategyId String @map("strategy_id") @db.VarChar(64)
 keyId String @map("key_id")
 idempotencyKey String @map("request_dedupe_key") @db.VarChar(100)
 orderType String @map("order_type") @db.VarChar(4)
 tradeSize Int @map("trade_size")
 eventId String @map("event_id") @db.VarChar(180)
 side String @db.VarChar(8)
 status String @default("RECEIVED_UNEXECUTED") @db.VarChar(32)
 createdAt DateTime @default(now()) @map("created_at")
 @@unique([strategyId,idempotencyKey])
 @@index([botId,createdAt])
 @@map("bot_trade_intents")
}

model SandboxAccount {
 strategyId String @id @map("strategy_id") @db.VarChar(64)
 strategy Strategy @relation(fields:[strategyId],references:[id],onDelete:Restrict)
 initialCashMicros BigInt @default(10000000000) @map("initial_cash_micros")
 cashMicros BigInt @default(10000000000) @map("cash_micros")
 realizedPnlMicros BigInt @default(0) @map("realized_pnl_micros")
 peakEquityMicros BigInt @default(10000000000) @map("peak_equity_micros")
 maxDrawdownBps Int @default(0) @map("max_drawdown_bps")
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")
 @@map("sandbox_accounts")
}
model SandboxFill {
 id String @id @default(cuid())
 strategyId String @map("strategy_id") @db.VarChar(64)
 strategy Strategy @relation(fields:[strategyId],references:[id],onDelete:Restrict)
 keyId String @map("key_id")
 requestKey String @map("request_key") @db.VarChar(100)
 eventId String @map("event_id") @db.VarChar(180)
 side String @db.VarChar(3)
 orderType String @map("order_type") @db.VarChar(4)
 quantity Int
 priceMicros BigInt @map("price_micros")
 notionalMicros BigInt @map("notional_micros")
 estimatedFeeMicros BigInt @map("estimated_fee_micros")
 realizedPnlMicros BigInt @default(0) @map("realized_pnl_micros")
 bookSnapshot Json @map("book_snapshot")
 venueObservedAt DateTime @map("venue_observed_at")
 createdAt DateTime @default(now()) @map("created_at")
 @@unique([strategyId,requestKey])
 @@index([strategyId,createdAt])
 @@map("sandbox_fills")
}
model SandboxPosition {
 strategyId String @map("strategy_id") @db.VarChar(64)
 eventId String @map("event_id") @db.VarChar(180)
 side String @db.VarChar(3)
 quantity Int @default(0)
 costBasisMicros BigInt @default(0) @map("cost_basis_micros")
 @@id([strategyId,eventId,side])
 @@map("sandbox_positions")
}
model StrategyRevenueRateVersion {
 id String @id @default(cuid())
 strategyId String @map("strategy_id") @db.VarChar(64)
 strategy Strategy @relation(fields:[strategyId],references:[id],onDelete:Restrict)
 managerPct Decimal @map("manager_pct") @db.Decimal(7,4)
 platformPct Decimal @map("platform_pct") @db.Decimal(7,4)
 effectiveAt DateTime @default(now()) @map("effective_at")
 changedBy String @map("changed_by")
 @@index([strategyId,effectiveAt])
 @@map("strategy_revenue_rate_versions")
}

model SandboxSettlement {
 id String @id @default(cuid())
 strategyId String @map("strategy_id") @db.VarChar(64)
 strategy Strategy @relation(fields:[strategyId],references:[id],onDelete:Restrict)
 eventId String @map("event_id") @db.VarChar(180)
 result String @db.VarChar(3)
 payoutMicros BigInt @map("payout_micros")
 realizedPnlMicros BigInt @map("realized_pnl_micros")
 providerEvidence Json @map("provider_evidence")
 observedAt DateTime @map("observed_at")
 createdAt DateTime @default(now()) @map("created_at")
 @@unique([strategyId,eventId])
 @@index([strategyId,createdAt])
 @@map("sandbox_settlements")
}

/** Durable email outbox; application requests themselves remain email-based. */
model BotManagerNotice {
 id String @id @default(cuid())
 userId String @map("user_id")
 user User @relation(fields:[userId],references:[id],onDelete:Restrict)
 kind String @db.VarChar(24)
 status String @default("PENDING") @db.VarChar(16)
 attempts Int @default(0)
 nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
 sentAt DateTime? @map("sent_at")
 createdAt DateTime @default(now()) @map("created_at")
 @@index([status,nextAttemptAt])
 @@map("bot_manager_notices")
}
