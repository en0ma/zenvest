{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Zenvest",
  "colors": {
    "primary": "#08785D",
    "light": "#16A27F",
    "dark": "#0B5A45"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Start here",
        "groups": [
          {
            "group": "Introduction",
            "pages": [
              "index",
              "getting-started",
              "how-it-works"
            ]
          }
        ]
      },
      {
        "tab": "Strategy",
        "groups": [
          {
            "group": "Methodology",
            "pages": [
              "strategy/yield",
              "strategy/allocations",
              "strategy/risk"
            ]
          }
        ]
      },
      {
        "tab": "Account",
        "groups": [
          {
            "group": "Account operations",
            "pages": [
              "account/security",
              "account/deposits-and-withdrawals"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Zenvest",
          "href": "https://zenvest-rust.vercel.app"
        },
        {
          "anchor": "Sign in",
          "href": "https://zenvest-rust.vercel.app/login"
        }
      ]
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/demo",
      "telegram": "https://t.me/demo"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://zenvest-rust.vercel.app"
      },
      {
        "label": "Log in",
        "href": "https://zenvest-rust.vercel.app/login"
      }
    ]
  },
  "appearance": {
    "default": "light",
    "strict": false
  }
}
