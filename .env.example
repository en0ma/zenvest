# PostgreSQL database, set in hosting secret manager
DATABASE_URL="postgresql://user:password@localhost:5432/zenvest?schema=public"
# Generate with: openssl rand -base64 48
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Set credentials for transactional mail
RESEND_API_KEY="re_your_email_provider_key"
EMAIL_FROM="Zenvest <accounts@your-verified-domain.example>"
